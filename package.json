{
  "name": "skill-reverse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build && wrangler deploy --dry-run",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "setup:local": "node scripts/setup-local.mjs",
    "setup:prod": "node scripts/setup-prod.mjs",
    "doctor": "node scripts/doctor.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.6",
    "hono": "^4.11.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260728.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.114.0"
  },
  "cloudflare": {
    "label": "Skill Reverse",
    "products": [
      "Workers",
      "Workflows",
      "D1",
      "R2",
      "Durable Objects",
      "Browser Run",
      "Turnstile"
    ],
    "categories": [
      "ai"
    ],
    "bindings": {
      "PERPLEXITY_API_KEY": {
        "description": "Required in public mode. Create a key at https://www.perplexity.ai/settings/api"
      },
      "TWITTERAPI_KEY": {
        "description": "Optional social provenance. Create a key at https://twitterapi.io"
      },
      "TURNSTILE_SITE_KEY": {
        "description": "Required in public mode. Public site key for your hostname."
      },
      "TURNSTILE_SECRET_KEY": {
        "description": "Required in public mode. Keep this server-side only."
      },
      "ANON_SESSION_SECRET": {
        "description": "Generated by pnpm setup:prod. Used to sign anonymous session cookies."
      }
    }
  },
  "packageManager": "pnpm@10.31.0"
}
