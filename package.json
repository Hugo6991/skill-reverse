{
  "name": "skill-reverse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "copycheck": "node scripts/check-ui-copy.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm copycheck && pnpm typecheck && pnpm test && pnpm build && wrangler deploy --dry-run",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "setup:local": "node scripts/setup-local.mjs",
    "bootstrap:cloudflare": "node scripts/bootstrap-cloudflare.mjs",
    "bootstrap:cloudflare:dry-run": "node scripts/bootstrap-cloudflare.mjs --dry-run",
    "setup:prod": "node scripts/setup-prod.mjs",
    "doctor": "node scripts/doctor.mjs",
    "backup:prod": "node scripts/backup-prod.mjs",
    "db:backfill-targets:remote": "node scripts/backfill-target-keys.mjs",
    "deploy": "node scripts/deploy.mjs",
    "release": "pnpm run backup:prod && pnpm run deploy"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.6",
    "hono": "^4.11.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.468.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^3.10.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260728.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.114.0"
  },
  "packageManager": "pnpm@10.31.0"
}
