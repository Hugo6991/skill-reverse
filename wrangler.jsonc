{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skill-reverse",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat_v2"],
  "workers_dev": true,
  "preview_urls": true,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "routes": [
    {
      "pattern": "skill-reverse.vibeencode.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "vars": {
    "APP_MODE": "locked",
    "JOB_USD_LIMIT": "0.50",
    "DAILY_USD_LIMIT": "5.00",
    "ANON_DAILY_JOB_LIMIT": "20",
    "GLOBAL_RESEARCH_CONCURRENCY": "2",
    "ACTOR_ACTIVE_JOB_LIMIT": "1",
    "ACTOR_OUTSTANDING_JOB_LIMIT": "10",
    "AUTO_RETRY_LIMIT": "1",
    "PUBLIC_APP_URL": "https://skill-reverse.vibeencode.dev",
    "OPENROUTER_SYNTHESIS_MODEL": "openai/gpt-5.6-terra",
    "REPORT_TTL_DAYS": "30",
    "ARTIFACT_TTL_DAYS": "7"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skill-reverse-db",
      "database_id": "3ab85f2a-e80a-4fa9-9814-320dfc945a2d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "skill-reverse-artifacts"
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "workflows": [
    {
      "name": "skill-reverse-research",
      "binding": "RESEARCH_WORKFLOW",
      "class_name": "ResearchWorkflow"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "skill-reverse-jobs",
        "binding": "RESEARCH_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "skill-reverse-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 3,
        "retry_delay": 10,
        "max_concurrency": 1,
        "dead_letter_queue": "skill-reverse-jobs-dlq"
      },
      {
        "queue": "skill-reverse-jobs-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 1,
        "max_concurrency": 1
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ACTOR_GATE",
        "class_name": "ActorGate"
      },
      {
        "name": "DAILY_BUDGET",
        "class_name": "DailyBudget"
      },
      {
        "name": "RESEARCH_SCHEDULER",
        "class_name": "ResearchScheduler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ActorGate", "DailyBudget"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ResearchScheduler"]
    }
  ],
  "ratelimits": [
    {
      "name": "BURST_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
